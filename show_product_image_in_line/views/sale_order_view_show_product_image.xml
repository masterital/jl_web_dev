<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record model="ir.ui.view" id="sale_order_tree_view_inherit">
            <field name="name">sale.order.tree.view.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group/group[2]/field[6]" position="after">
                    <field name="show_image_field" class="form-check-label" style="width:3px;height:2px;"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                    <field name="order_line_image" widget="image" class="oe_avatar" options="{'size': [70, 70]}"
                           column_invisible="not parent.show_image_field"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/form/group/group/field[@name='product_id']" position="after">
                    <field name="order_line_image" widget="image" class="oe_avatar"
                           invisible="not parent.show_image_field"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>