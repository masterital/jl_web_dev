<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="set_image_account_move_inherit">
            <field name="name">account.move.form.view.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_shipping_id']" position="after">
                    <field name="show_image_field" class="form-check-label" style="width:2px;height:2px;"/>
                </xpath>

                <xpath expr="//tree/field[@name='product_id']" position="after">
                    <field name="invoice_product_image" style="float:left;" widget="image" class="oe_avatar"
                           options="{'size': [70, 70]}" column_invisible="not parent.show_image_field"/>
                </xpath>

                <xpath expr="//form/sheet/group/field[@name='product_id']" position="after">
                    <field name="invoice_product_image" widget="image" class="oe_avatar" options="{'size': [70, 70]}"
                           invisible="not parent.show_image_field"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>