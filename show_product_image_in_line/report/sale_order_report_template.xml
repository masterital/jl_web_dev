<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_course_document" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table/thead/tr/th[@name='th_description']" position="after">
            <th t-if="doc.show_image_field">
                <span>Image</span>
            </th>
        </xpath>

        <xpath expr="//tbody/t[2]/tr/t[1]/td[@name='td_name']" position="after">
            <td t-if="doc.show_image_field">
                <img t-attf-src="/web/image/sale.order.line/{{line.id}}/order_line_image" width="70px"/>
            </td>
        </xpath>
    </template>

    <template id="sale_order_preview_template_image" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//table[@id='sales_order_table']/thead/tr/th[hasclass('text-start')]" position="after">
            <th t-if="sale_order.show_image_field">
                <span>Image</span>
            </th>
        </xpath>

        <xpath expr="//table[@id='sales_order_table']/tbody/t[3]/tr/t/td[@id='product_name']" position="after">
            <td t-if="sale_order.show_image_field">
                <img t-attf-src="/web/image/sale.order.line/{{line.id}}/order_line_image" width="70px"/>
                <!--            <span>Image</span>-->
            </td>
        </xpath>
    </template>


</odoo>